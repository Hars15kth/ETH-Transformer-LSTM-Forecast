      "source": [
        "import argparse\n",
        "import pandas as pd\n",
        "import torch\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from preprocess import create_sequences\n",
        "from model import MultiHeadLSTM\n",
        "\n",
        "def load_csv(path):\n",
        "    df = pd.read_csv(path)\n",
        "    df['timestamp'] = pd.to_datetime(df['timestamp'])\n",
        "    df = df.sort_values('timestamp')\n",
        "    return df\n",
        "\n",
        "def main(args):\n",
        "    # Load and merge datasets\n",
        "    df_utk = load_csv(args.utk_path)\n",
        "    df_export = load_csv(args.export_path)\n",
        "    df = pd.merge(df_utk, df_export, on='timestamp', how='inner')\n",
        "\n",
        "    # Create sequences\n",
        "    sequences = create_sequences(df, window=args.window_size)\n",
        "    X = torch.tensor(sequences[:, :-1, :], dtype=torch.float32)\n",
        "    y = torch.tensor(sequences[:, -1, 0], dtype=torch.float32).unsqueeze(1)\n",
        "\n",
        "    # DataLoader\n",
        "    loader = DataLoader(TensorDataset(X, y), batch_size=args.batch_size, shuffle=True)\n",
        "\n",
        "    # Model\n",
        "    model = MultiHeadLSTM(input_size=X.shape[2], hidden_size=64, num_heads=3)\n",
        "    optimizer = torch.optim.Adam(model.parameters(), lr=args.learning_rate)\n",
        "    loss_fn = torch.nn.MSELoss()\n",
        "\n",
        "    # Training loop\n",
        "    for epoch in range(args.epochs):\n",
        "        for xb, yb in loader:\n",
        "            pred = model(xb)\n",
        "            loss = loss_fn(pred, yb)\n",
        "            optimizer.zero_grad()\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "        print(f\"Epoch {epoch+1}: Loss = {loss.item():.4f}\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    parser = argparse.ArgumentParser()\n",
        "    parser.add_argument(\"--utk_path\", type=str, required=True, help=\"Path to UTKUSDT CSV file\")\n",
        "    parser.add_argument(\"--export_path\", type=str, required=True, help=\"Path to EXPORTTOKENS CSV file\")\n",
        "    parser.add_argument(\"--window_size\", type=int, default=30, help=\"Rolling window size\")\n",
        "    parser.add_argument(\"--epochs\", type=int, default=10, help=\"Number of training epochs\")\n",
        "    parser.add_argument(\"--batch_size\", type=int, default=32, help=\"Batch size\")\n",
        "    parser.add_argument(\"--learning_rate\", type=float, default=0.001, help=\"Learning rate\")\n",
        "    args = parser.parse_args()\n",
        "    main(args)"
      ]
    },
